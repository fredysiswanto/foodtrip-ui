{
  "name": "foodtrip-ui",
  "version": "1.0.0",
  "type": "module",
  "description": "FoodTrip Frontend Monorepo",
  "private": true,
  "packageManager": "pnpm@10.16.0",
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm -r --parallel run dev",
    "dev:admin": "pnpm --filter admin run dev",
    "dev:client": "pnpm --filter client run dev",
    "build": "pnpm -r --parallel run build",
    "lint11": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint": "pnpm -r lint",
    "preview": "pnpm -r run preview",
    "local-api": "json-server --watch db.json --port 3001"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^6.1.1",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "json-server": "1.0.0-beta.15",
    "lint-staged": "^17.2.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.5"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@tanstack/react-query": "^5.101.4",
    "jose": "^6.2.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.83.0",
    "react-router-dom": "^6.30.4"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  }
}
